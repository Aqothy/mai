# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
# Vendored, checksum-pinned native search library (see third_party/fff/MANIFEST.json)
!third_party/fff/lib/**/*.dylib
bin/
tmp/

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

xcuserdata/
buildServer.json
Local.xcconfig
