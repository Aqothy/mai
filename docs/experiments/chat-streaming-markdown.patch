+import Observation
+import SwiftUI
+
+/// Owns the throttled, incremental parse loop for one live response.
+@MainActor
+@Observable
+final class ChatStreamingMarkdownRenderer {
+    private(set) var plan: ChatMarkdownRenderPlan?
+    private(set) var renderedSource = ""
+
+    @ObservationIgnored private var latestSource = ""
+    @ObservationIgnored private var renderTask: Task<Void, Never>?
+    @ObservationIgnored private let worker = ChatStreamingMarkdownWorker()
+
+    func submit(_ source: String) {
+        latestSource = source
+        guard renderTask == nil else { return }
+
+        renderTask = Task { [weak self] in
+            guard let self else { return }
+            while !Task.isCancelled {
+                let source = latestSource
+                let plan = await worker.plan(from: source)
+                guard !Task.isCancelled else { break }
+
+                self.plan = plan
+                renderedSource = source
+
+                do {
+                    // A latest-wins throttle caps parsing and List remeasurement
+                    // during rapid token bursts at 12.5 updates per second,
+                    // while slower providers still render immediately.
+                    try await Task.sleep(for: .milliseconds(80))
+                } catch {
+                    break
+                }
+
+                if latestSource == source {
+                    renderTask = nil
+                    return
+                }
+            }
+            renderTask = nil
+        }
+    }
+
+    func cancel() {
+        renderTask?.cancel()
+        renderTask = nil
+    }
+}
+
+private actor ChatStreamingMarkdownWorker {
+    private var planner = ChatIncrementalMarkdownRenderPlanner()
+
+    func plan(from source: String) -> ChatMarkdownRenderPlan {
+        planner.plan(from: source)
+    }
+}
+
+/// Displays the latest coalesced plan. During a rapid burst the visible text
+/// can trail the source by at most one throttle interval, avoiding a temporary
+/// plain suffix that would jump between block layouts.
+struct ChatStreamingMarkdownContentView: View {
+    let source: String
+
+    @State private var renderer = ChatStreamingMarkdownRenderer()
+
+    var body: some View {
+        Group {
+            if let plan = renderer.plan,
+                source.hasPrefix(renderer.renderedSource)
+            {
+                ChatMarkdownRichContentView(
+                    plan: plan,
+                    allowsHighlighting: false
+                )
+            } else {
+                Text(verbatim: source)
+                    .frame(maxWidth: .infinity, alignment: .leading)
+            }
+        }
+        .onChange(of: source, initial: true) { _, newSource in
+            renderer.submit(newSource)
+        }
+        .onDisappear {
+            renderer.cancel()
+        }
+    }
+}
