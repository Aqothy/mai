+/// Retains root blocks that can no longer be changed by an appended source
+/// suffix. Continuous streams therefore reparse only the active trailing
+/// block rather than every byte accumulated so far.
+nonisolated struct ChatIncrementalMarkdownRenderPlanner {
+    private var stableUTF8Count = 0
+    private var stableBlocks: [ChatMarkdownRenderPlan.Block] = []
+    private var previousSource = ""
+
+    mutating func plan(from source: String) -> ChatMarkdownRenderPlan {
+        if !source.hasPrefix(previousSource) {
+            reset()
+        }
+
+        let bytes = Array(source.utf8)
+        if stableUTF8Count > bytes.count {
+            reset()
+        }
+
+        let tail = String(
+            decoding: bytes[stableUTF8Count...],
+            as: UTF8.self
+        )
+        let parsed = ChatMarkdownRenderPlanner.parsedBlocks(from: tail)
+
+        let currentBlocks: [ChatMarkdownRenderPlan.Block]
+        if parsed.count > 1, let activeBlock = parsed.last,
+            activeBlock.utf8Offset > 0
+        {
+            stableBlocks.append(contentsOf: parsed.dropLast().map(\.block))
+            stableUTF8Count += activeBlock.utf8Offset
+            currentBlocks = stableBlocks + [activeBlock.block]
+        } else if parsed.isEmpty, !tail.isEmpty {
+            currentBlocks = stableBlocks + [.prose(AttributedString(tail))]
+        } else {
+            currentBlocks = stableBlocks + parsed.map(\.block)
+        }
+
+        previousSource = source
+        return ChatMarkdownRenderPlan(blocks: currentBlocks)
+    }
+
+    mutating func reset() {
+        stableUTF8Count = 0
+        stableBlocks.removeAll(keepingCapacity: true)
+        previousSource = ""
+    }
+}
