+#if os(macOS)
+    import AppKit
+
+    /// Native presentation for prepared assistant prose, code and tables.
+    /// Unsupported rows retain the existing SwiftUI renderer. Geometry still comes
+    /// from that renderer to preserve the same row geometry.
+    final class ChatNativePreparedRow: NSView {
+        enum Content: Equatable {
+            case prose(String)
+            case resolvedProse(ChatMarkdownProseRun)
+            case code(ChatMarkdownCodeBlock)
+            case table(ChatMarkdownTable)
+        }
+        struct Descriptor: Equatable {
+            let id: String
+            let content: Content
+            let top: CGFloat
+            let bottom: CGFloat
