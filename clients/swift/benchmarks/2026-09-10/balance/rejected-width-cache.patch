+        /// Keep the latest width for each row. A resize must replace its old
+        /// measurement rather than retain another complete attributed layout.
+        private struct WidthCache<Value> {
+            private var values: [String: (width: CGFloat, value: Value)] = [:]
+            var count: Int { values.count }
+
+            subscript(key: Key) -> Value? {
+                get {
+                    guard let entry = values[key.id], entry.width == key.width else { return nil }
+                    return entry.value
+                }
+                set {
+                    if let newValue { values[key.id] = (key.width, newValue) }
+                    else if values[key.id]?.width == key.width { values[key.id] = nil }
+                }
+            }
+        }
