+            func stopPreparation() {
+                preparationTask?.cancel()
+                preparationTask = nil
+                NotificationCenter.default.removeObserver(self, name: NSView.boundsDidChangeNotification, object: nil)
+            }
+
+            @objc private func prepareNearbyContent() {
+                preparationTask?.cancel()
+                preparationTask = Task(priority: .utility) { @MainActor [weak self] in
+                    await Task.yield()
+                    guard !Task.isCancelled, let self, let table = self.tableView,
+                          table.window != nil, let clip = table.enclosingScrollView?.contentView else { return }
+                    let visible = clip.documentVisibleRect
+                    let rect = visible.insetBy(dx: 0, dy: -visible.height).intersection(table.bounds)
+                    guard rect != self.preparedRect else { return }
+                    self.preparedRect = rect
+                    table.prepareContent(in: rect)
+                }
+            }
 
             override func hitTest(_ point: NSPoint) -> NSView? { nil }
 
