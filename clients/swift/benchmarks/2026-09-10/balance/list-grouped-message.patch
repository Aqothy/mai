--- a/ChatListRowGroup.swift
+++ b/ChatListRowGroup.swift
@@ -0,0 +1,29 @@
+import SwiftUI
+
+@MainActor struct ChatListRowGroup: Identifiable {
+    let id: String
+    var rows: [ChatTimelineRenderRow]
+    static var benchmarkAnchorRow: Int?
+
+    static func group(_ rows: [ChatTimelineRenderRow]) -> [Self] {
+        var groups: [Self] = []
+        let originalAnchor = UserDefaults.standard.integer(forKey: "ChatBenchmarkAnchorRow")
+        for (index, row) in rows.enumerated() {
+            let id: String
+            switch row {
+            case .standard: id = row.id
+            case .prose(let segment), .richMarkdown(let segment): id = segment.messageID
+            case .resolvedMarkdown(let block): id = block.messageID
+            }
+            if groups.last?.id == id {
+                groups[groups.count - 1].rows.append(row)
+            } else {
+                groups.append(Self(id: id, rows: [row]))
+            }
+            if index == originalAnchor {
+                benchmarkAnchorRow = groups.count - 1
+            }
+        }
+        return groups
+    }
+}
