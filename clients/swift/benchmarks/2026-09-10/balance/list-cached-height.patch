--- a/ChatListRowHeightCache.swift
+++ b/ChatListRowHeightCache.swift
@@ -0,0 +1,30 @@
+#if os(macOS)
+import AppKit
+import SwiftUI
+
+/// Experiment: only settled rows use exact cached SwiftUI measurements.
+@MainActor final class ChatListRowHeightCache {
+    private struct Entry {
+        let key: ChatNativeRowMeasurementKey
+        let width: CGFloat
+        let colorScheme: ColorScheme
+        let dynamicType: DynamicTypeSize
+        let height: CGFloat
+    }
+    private var entries: [String: Entry] = [:]
+    func height<Content: View>(id: String, key: ChatNativeRowMeasurementKey, width: CGFloat,
+                              colorScheme: ColorScheme, dynamicType: DynamicTypeSize,
+                              content: Content) -> CGFloat {
+        if let previous = entries[id], previous.key == key, previous.width == width,
+           previous.colorScheme == colorScheme, previous.dynamicType == dynamicType {
+            return previous.height
+        }
+        let host = NSHostingController(rootView: content.environment(\.colorScheme, colorScheme)
+            .environment(\.dynamicTypeSize, dynamicType).frame(width: width))
+        let height = ceil(host.sizeThatFits(in: CGSize(width: width, height: .greatestFiniteMagnitude)).height)
+        entries[id] = Entry(key: key, width: width, colorScheme: colorScheme,
+                            dynamicType: dynamicType, height: height)
+        return height
+    }
+}
+#endif
