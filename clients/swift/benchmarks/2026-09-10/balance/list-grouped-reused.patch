--- a/ChatListPreparedRow.swift
+++ b/ChatListPreparedRow.swift
@@ -0,0 +1,51 @@
+#if os(macOS)
+import AppKit
+import SwiftUI
+
+/// Experiment: retain List while collapsing settled rich rows to one representable.
+struct ChatListPreparedRow: NSViewRepresentable {
+    let descriptor: ChatNativePreparedRow.Descriptor
+    let store: ChatTextLayoutStore
+    @Environment(\.colorScheme) private var colorScheme
+    private var theme: ChatCodeHighlightTheme { colorScheme == .dark ? .dark : .light }
+
+    func makeNSView(context: Context) -> ChatNativePreparedRow {
+        store.experimentalActiveListRows += 1
+        return store.experimentalListRows.popLast() ?? ChatNativePreparedRow(frame: .zero)
+    }
+    func makeCoordinator() -> ChatTextLayoutStore { store }
+    static func dismantleNSView(_ view: ChatNativePreparedRow, coordinator: ChatTextLayoutStore) {
+        coordinator.experimentalActiveListRows -= 1
+        let capacity = coordinator.experimentalActiveListRows
+        if coordinator.experimentalListRows.count < capacity {
+            coordinator.experimentalListRows.append(view)
+        } else if coordinator.experimentalListRows.count > capacity {
+            coordinator.experimentalListRows.removeLast(coordinator.experimentalListRows.count - capacity)
+        }
+    }
+    func updateNSView(_ view: ChatNativePreparedRow, context: Context) {
+        view.update(descriptor, width: view.bounds.width, store: store, theme: theme)
+    }
+    func sizeThatFits(_ proposal: ProposedViewSize, nsView: ChatNativePreparedRow,
+                     context: Context) -> CGSize? {
+        guard let width = proposal.width, width.isFinite, width > 0 else { return nil }
+        let height: CGFloat
+        switch descriptor.content {
+        case .prose(let source):
+            height = store.layout(id: descriptor.id, source: source, style: .markdownProse, width: width).height
+        case .resolvedProse(let prose):
+            height = store.resolvedLayout(id: descriptor.id, prose: prose, width: width).height
+        case .code(let block):
+            let font = NSFont.preferredFont(forTextStyle: .callout)
+            height = store.codeLayout(id: descriptor.id, block: block, theme: theme).layout.height
+                + ChatMacCodeStyle.bottomInset + ceil(font.ascender - font.descender + font.leading)
+                + ChatRichBlockStyle.codeHeaderTopInset + ChatRichBlockStyle.codeHeaderBottomInset
+        case .table(let table):
+            height = store.tableLayout(id: descriptor.id, table: table).size.height
+                + ChatRichBlockStyle.tableToolbarHeight
+        }
+        nsView.update(descriptor, width: width, store: store, theme: theme)
+        return CGSize(width: width, height: height + descriptor.top + descriptor.bottom)
+    }
+}
+#endif
