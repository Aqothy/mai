+#if os(macOS) && DEBUG
+import AppKit
+import SwiftUI
+
+/// Diagnostic ceiling experiment, not a production timeline: measures the
+/// existing settled row views before scrolling and retains geometry only.
+/// Cold preparation cost is logged separately; it must not be claimed as free.
+struct ChatNativeTableExperiment<Content: View>: NSViewRepresentable {
+    let ids: [String]
+    let width: CGFloat
+    @ViewBuilder let content: (Int) -> Content
+
+    func makeCoordinator() -> Coordinator { Coordinator() }
+
+    func makeNSView(context: Context) -> NSScrollView {
+        let scroll = NSScrollView()
+        scroll.hasVerticalScroller = true
+        scroll.drawsBackground = false
+        let table = context.coordinator.table
+        table.headerView = nil
+        table.style = .plain
+        table.rowSizeStyle = .custom
+        table.backgroundColor = .clear
+        table.intercellSpacing = .zero
+        table.usesAutomaticRowHeights = false
+        table.selectionHighlightStyle = .none
+        table.columnAutoresizingStyle = .lastColumnOnlyAutoresizingStyle
+        let column = NSTableColumn(identifier: NSUserInterfaceItemIdentifier("content"))
+        table.addTableColumn(column)
+        table.delegate = context.coordinator
+        table.dataSource = context.coordinator
+        if UserDefaults.standard.bool(forKey: "ChatCustomVirtualizationExperiment") {
+            let document = context.coordinator.virtualDocument
+            scroll.documentView = document
+            scroll.contentView.postsBoundsChangedNotifications = true
+            NotificationCenter.default.addObserver(document, selector: #selector(document.viewportChanged),
+                name: NSView.boundsDidChangeNotification, object: scroll.contentView)
+        } else {
+            scroll.documentView = table
+        }
+        return scroll
+    }
+
+    func updateNSView(_ scroll: NSScrollView, context: Context) {
+        context.coordinator.update(ids: ids, width: width, content: content)
+    }
+
+    static func dismantleNSView(_ scroll: NSScrollView, coordinator: Coordinator) {
+        coordinator.task?.cancel()
+        NotificationCenter.default.removeObserver(coordinator.virtualDocument)
+        coordinator.virtualDocument.preparationTask?.cancel()
+        coordinator.table.delegate = nil
+        coordinator.table.dataSource = nil
+    }
+
+    final class Coordinator: NSObject, NSTableViewDelegate, NSTableViewDataSource {
+        let table = NSTableView()
+        let virtualDocument = VirtualDocument()
+        var task: Task<Void, Never>?
+        var ids: [String] = []
+        var width: CGFloat = 0
+        var heights: [CGFloat] = []
+        var content: ((Int) -> Content)?
+
+        func update(ids: [String], width: CGFloat, content: @escaping (Int) -> Content) {
+            guard width > 0, !ids.isEmpty else { return }
+            guard self.ids != ids || self.width != width else { return }
+            self.ids = ids
+            self.width = width
+            task?.cancel()
+            ChatBenchmarkAutoRun.isNativeGeometryWarm = false
+            task = Task { @MainActor [weak self] in
+                guard let self else { return }
+                // Match the baseline's text preparation before measuring rows.
+                while !ChatBenchmarkAutoRun.isTranscriptWarm {
+                    if Task.isCancelled { return }
+                    try? await Task.sleep(for: .milliseconds(50))
+                }
+                let started = ContinuousClock.now
+                let measure = NSHostingController(rootView: content(0))
+                var result: [CGFloat] = []
+                result.reserveCapacity(ids.count)
+                for index in ids.indices {
+                    if Task.isCancelled { return }
+                    measure.rootView = content(index)
+                    let size = measure.sizeThatFits(in: CGSize(width: width, height: .greatestFiniteMagnitude))
+                    result.append(max(1, ceil(size.height)))
+                    await Task.yield()
+                }
+                guard !Task.isCancelled else { return }
+                self.content = content
+                self.heights = result
+                self.table.tableColumns.first?.width = width
+                if UserDefaults.standard.bool(forKey: "ChatCustomVirtualizationExperiment") {
+                    self.virtualDocument.install(heights: result, width: width, content: content)
+                } else {
+                    self.table.reloadData()
+                    self.table.noteHeightOfRows(withIndexesChanged: IndexSet(integersIn: result.indices))
+                    self.table.layoutSubtreeIfNeeded()
+                    ChatBenchmarkAutoRun.trace("native table automatic=\(self.table.usesAutomaticRowHeights) bounds=\(self.table.bounds) row4800=\(self.table.rect(ofRow: min(4800, result.count - 1)))")
+                }
+                ChatBenchmarkAutoRun.trace("native geometry rows=\(result.count) width=\(width) totalHeight=\(result.reduce(0,+)) elapsed=\(started.duration(to: .now))")
+                ChatBenchmarkAutoRun.isNativeGeometryWarm = true
+            }
+        }
+
+        func numberOfRows(in tableView: NSTableView) -> Int { heights.count }
+        func tableView(_ tableView: NSTableView, heightOfRow row: Int) -> CGFloat { heights[row] }
+        func tableView(_ tableView: NSTableView, shouldSelectRow row: Int) -> Bool { false }
+        func tableView(_ tableView: NSTableView, viewFor tableColumn: NSTableColumn?, row: Int) -> NSView? {
+            guard let content else { return nil }
+            let identifier = NSUserInterfaceItemIdentifier("content")
+            let cell = tableView.makeView(withIdentifier: identifier, owner: nil) as? Cell
+                ?? Cell(content: content(row))
+            cell.identifier = identifier
+            cell.host.rootView = content(row)
+            return cell
+        }
+    }
+    final class Cell: NSView {
+        let host: NSHostingView<Content>
+        override var isFlipped: Bool { true }
+        init(content: Content) {
+            host = NSHostingView(rootView: content)
+            host.sizingOptions = []
+            super.init(frame: .zero)
+            addSubview(host)
+        }
+        @available(*, unavailable)
+        required init?(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }
+        override func layout() {
+            super.layout()
+            host.frame = bounds
+        }
+    }
+
+    final class VirtualDocument: NSView, ChatBenchmarkAnchoredDocument {
+        func scrollToBenchmarkRow(_ index: Int) {
+            guard index >= 0, index < offsets.count - 1 else { return }
+            enclosingScrollView?.contentView.scroll(to: NSPoint(x: 0, y: offsets[index]))
+        }
+        override var isFlipped: Bool { true }
+        var offsets: [CGFloat] = [0]
+        var content: ((Int) -> Content)?
+        var hosts: [Int: NSHostingView<Content>] = [:]
+        var reusable: [NSHostingView<Content>] = []
+        var preparationTask: Task<Void, Never>?
+        var preparedRange: ClosedRange<Int>?
+        var lastVisibleRange: ClosedRange<Int>?
+
+        func install(heights: [CGFloat], width: CGFloat, content: @escaping (Int) -> Content) {
+            preparationTask?.cancel()
+            preparedRange = nil
+            lastVisibleRange = nil
+            self.content = content
+            offsets = [0]
+            for height in heights { offsets.append((offsets.last ?? 0) + height) }
+            for host in hosts.values { host.removeFromSuperview() }
+            hosts.removeAll()
+            reusable.removeAll()
+            setFrameSize(NSSize(width: enclosingScrollView?.contentSize.width ?? width, height: offsets.last ?? 0))
+            viewportChanged()
+        }
+
+        func row(at y: CGFloat) -> Int {
+            var lower = 0
+            var upper = offsets.count - 1
+            while lower < upper {
+                let middle = (lower + upper + 1) / 2
+                if offsets[middle] <= y { lower = middle } else { upper = middle - 1 }
+            }
+            return min(lower, offsets.count - 2)
+        }
+
+        @objc func viewportChanged() {
+            guard let content, offsets.count > 1, let scroll = enclosingScrollView else { return }
+            let visible = scroll.contentView.documentVisibleRect
+            // One viewport of preparation on either side bounds resident views
+            // while allowing ordinary wheel input to reuse already mounted rows.
+            let first = max(0, row(at: max(0, visible.minY - visible.height)))
+            let last = row(at: min(frame.height, visible.maxY + visible.height))
+            guard first <= last else { return }
+            for index in Array(hosts.keys) where !(first...last).contains(index) {
+                if let host = hosts.removeValue(forKey: index) {
+                    host.removeFromSuperview()
+                    reusable.append(host)
+                }
+            }
+            if UserDefaults.standard.bool(forKey: "ChatScheduledPrewarmExperiment") {
+                let visibleFirst = max(first, row(at: visible.minY))
+                let visibleLast = min(last, row(at: visible.maxY))
+                for index in visibleFirst...visibleLast { mount(index, width: visible.width, content: content) }
+                let visibleRange = visibleFirst...visibleLast
+                let previousVisibleRange = lastVisibleRange
+                lastVisibleRange = visibleRange
+                // A jump beyond the prior viewport cannot reuse nearby rows.
+                // Spend this frame on the destination instead of preparing
+                // neighbors that the next scrub update will discard.
+                if let previousVisibleRange, !previousVisibleRange.overlaps(visibleRange) {
+                    preparationTask?.cancel()
+                    preparationTask = nil
+                    preparedRange = nil
+                    return
+                }
+                let range = first...last
+                guard range != preparedRange else { return }
+                preparedRange = range
+                preparationTask?.cancel()
+                preparationTask = Task(priority: .utility) { @MainActor [weak self] in
+                    let nearby = range.sorted {
+                        min(abs($0 - visibleFirst), abs($0 - visibleLast))
+                        < min(abs($1 - visibleFirst), abs($1 - visibleLast))
+                    }
+                    for index in nearby {
+                        guard !Task.isCancelled, let self else { return }
+                        if self.hosts[index] == nil { self.mount(index, width: visible.width, content: content) }
+                        await Task.yield()
+                    }
+                }
+            } else {
+                for index in first...last { mount(index, width: visible.width, content: content) }
+            }
+        }
+
+        private func mount(_ index: Int, width: CGFloat, content: (Int) -> Content) {
+            let host: NSHostingView<Content>
+            if let existing = hosts[index] { host = existing }
+            else {
+                host = reusable.popLast() ?? NSHostingView(rootView: content(index))
+                host.sizingOptions = []
+                host.rootView = content(index)
+                let next = hosts.keys.filter { $0 > index }.min().flatMap { hosts[$0] }
+                hosts[index] = host
+                addSubview(host, positioned: next == nil ? .above : .below, relativeTo: next)
+            }
+            host.frame = NSRect(x: 0, y: offsets[index], width: width,
+                                height: offsets[index + 1] - offsets[index])
+            // Offscreen preparation must perform display layout now; mounting
+            // an unlaid-out hosting view only postpones the work until exposure.
+            host.layoutSubtreeIfNeeded()
+        }
+    }
+
+}
