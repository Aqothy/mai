maid.db layout 1

# Tables and indexes

CREATE TABLE deliveries (
	delivery_id TEXT PRIMARY KEY,
	thread_id TEXT NOT NULL REFERENCES threads(thread_id) ON DELETE CASCADE,
	to_participant TEXT NOT NULL,
	from_actor TEXT NOT NULL,
	kind TEXT NOT NULL,
	mode TEXT NOT NULL,
	body TEXT,
	state TEXT NOT NULL,
	turn_id TEXT NOT NULL DEFAULT '',
	hops INTEGER NOT NULL,
	reason TEXT NOT NULL DEFAULT '',
	wants_reply INTEGER NOT NULL DEFAULT 0,
	answers TEXT NOT NULL DEFAULT '',
	answer TEXT,
	position REAL NOT NULL,
	sent_at TEXT NOT NULL DEFAULT '',
	created_at TEXT NOT NULL
) STRICT;
CREATE UNIQUE INDEX deliveries_answers ON deliveries(answers) WHERE answers <> '';
CREATE INDEX deliveries_thread ON deliveries(thread_id, state);
CREATE TABLE native_mirror (
	instance_id TEXT NOT NULL,
	native_session TEXT NOT NULL,
	seq INTEGER NOT NULL,
	frames BLOB NOT NULL,
	PRIMARY KEY (instance_id, native_session, seq),
	FOREIGN KEY (instance_id, native_session) REFERENCES sessions(instance_id, native_session) ON DELETE CASCADE
) STRICT;
CREATE TABLE participants (
	participant_id TEXT PRIMARY KEY,
	thread_id TEXT NOT NULL REFERENCES threads(thread_id) ON DELETE CASCADE,
	instance_id TEXT NOT NULL,
	settings TEXT,
	native_session TEXT NOT NULL DEFAULT '',
	seen_through TEXT NOT NULL DEFAULT ''
) STRICT;
CREATE UNIQUE INDEX participants_native ON participants(instance_id, native_session) WHERE native_session <> '';
CREATE TABLE projects (
	path TEXT PRIMARY KEY,
	added_at TEXT NOT NULL
) STRICT;
CREATE TABLE receipts (
	actor TEXT NOT NULL,
	key TEXT NOT NULL,
	result TEXT NOT NULL,
	created_at TEXT NOT NULL,
	PRIMARY KEY (actor, key)
) STRICT;
CREATE TABLE session_entries (
	instance_id TEXT NOT NULL,
	native_session TEXT NOT NULL,
	seq INTEGER NOT NULL,
	ref TEXT NOT NULL,
	turn_ref TEXT NOT NULL,
	entry TEXT NOT NULL,
	authored TEXT NOT NULL,
	PRIMARY KEY (instance_id, native_session, seq),
	FOREIGN KEY (instance_id, native_session) REFERENCES sessions(instance_id, native_session) ON DELETE CASCADE
) STRICT;
CREATE INDEX session_entries_in_progress ON session_entries(instance_id, native_session, seq) WHERE json_extract(entry, '$.status') = 'in_progress';
CREATE UNIQUE INDEX session_entries_ref ON session_entries(instance_id, native_session, ref);
CREATE INDEX session_entries_turn ON session_entries(instance_id, native_session, turn_ref, seq);
CREATE TABLE sessions (
	instance_id TEXT NOT NULL,
	native_session TEXT NOT NULL,
	thread_id TEXT REFERENCES threads(thread_id) ON DELETE CASCADE,
	marker TEXT NOT NULL DEFAULT '',
	version INTEGER NOT NULL DEFAULT 0,
	touched_at TEXT NOT NULL,
	PRIMARY KEY (instance_id, native_session)
) STRICT;
CREATE INDEX sessions_thread ON sessions(thread_id);
CREATE INDEX sessions_unowned ON sessions(instance_id) WHERE thread_id IS NULL;
CREATE TABLE terminal_threads (
	terminal_id TEXT PRIMARY KEY,
	title       TEXT NOT NULL DEFAULT '',
	cwd         TEXT NOT NULL,
	created_at  TEXT NOT NULL,
	updated_at  TEXT NOT NULL
) STRICT;
CREATE TABLE threads (
	thread_id TEXT PRIMARY KEY,
	title TEXT NOT NULL,
	workspace TEXT NOT NULL,
	origin_kind TEXT NOT NULL,
	parent_id TEXT REFERENCES threads(thread_id) ON DELETE CASCADE,
	origin_by TEXT NOT NULL DEFAULT '',
	origin_at TEXT NOT NULL DEFAULT '',
	contract TEXT,
	accepts_input INTEGER NOT NULL DEFAULT 0,
	forked_from_thread TEXT REFERENCES threads(thread_id) ON DELETE SET NULL,
	forked_from_turn TEXT NOT NULL DEFAULT '',
	address TEXT NOT NULL DEFAULT '',
	hold TEXT NOT NULL DEFAULT '',
	policy TEXT,
	seen_at TEXT NOT NULL DEFAULT '',
	created_at TEXT NOT NULL,
	updated_at TEXT NOT NULL
) STRICT;
CREATE INDEX threads_parent ON threads(parent_id);
CREATE TABLE turns (
	turn_id TEXT PRIMARY KEY,
	thread_id TEXT NOT NULL REFERENCES threads(thread_id) ON DELETE CASCADE,
	participant_id TEXT NOT NULL,
	native_session TEXT NOT NULL,
	native_ref TEXT NOT NULL,
	started_by TEXT NOT NULL,
	by_agent INTEGER NOT NULL DEFAULT 0,
	hops INTEGER NOT NULL,
	state TEXT NOT NULL,
	stop_reason TEXT NOT NULL DEFAULT '',
	error TEXT NOT NULL DEFAULT '',
	report TEXT,
	started_at TEXT NOT NULL,
	settled_at TEXT NOT NULL DEFAULT ''
) STRICT;
CREATE UNIQUE INDEX turns_native ON turns(thread_id, native_session, native_ref);
CREATE INDEX turns_order ON turns(thread_id, started_at, turn_id);

